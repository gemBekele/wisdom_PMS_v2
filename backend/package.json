{
  "name": "sako-pms-backend",
  "version": "1.0.0",
  "description": "SAKO Microfinance Performance Management System Backend",
  "main": "src/server.js",
  "type": "module",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "seed": "node src/scripts/seedAdmin.js",
    "seed:all": "node src/scripts/seedAllUsers.js",
    "seed:products": "node src/scripts/seedProductMappings.js",
    "seed:atote": "node src/scripts/seedAtoteUsers.js",
    "seed:all-data": "node src/scripts/seedAllData.js",
    "seed:ghion": "node src/scripts/seedGhionSaccos.js",
    "seed:files": "node src/scripts/seedFromFiles.js",
    "seed:hawassa": "node src/scripts/seedHawassaDemo.js",
    "seed:test": "node src/scripts/seedTestData.js",
    "clean:test": "node src/scripts/cleanSystemData.js",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:generate": "prisma generate",
    "db:studio": "prisma studio",
    "test": "NODE_ENV=test node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "test:watch": "NODE_ENV=test node --experimental-vm-modules node_modules/jest/bin/jest.js --watch"
  },
  "keywords": [
    "pms",
    "microfinance",
    "performance"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "csv-parser": "^3.0.0",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-validator": "^7.0.1",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "node-cron": "^4.6.0",
    "prisma": "^5.22.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@jest/globals": "^30.2.0",
    "jest": "^30.2.0",
    "nodemon": "^3.0.2",
    "supertest": "^7.1.4"
  }
}
